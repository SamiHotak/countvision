# CountVision cloud settings for local development. Copy to ".env" (never committed).
# Everything works WITHOUT changing this file. Fill in only what you need.

# Address of the web app in your browser (links in emails point here)
CV_WEB_URL=http://localhost:3000

# Any long random text. For local use the default is fine; production needs its own.
# CV_SECRET_KEY=

# "Continue with Google" button (optional, free). How to get the two values: cloud/README.md
# CV_GOOGLE_CLIENT_ID=
# CV_GOOGLE_CLIENT_SECRET=

# Log detail: DEBUG = a lot, INFO = normal, WARNING = only problems
CV_LOG_LEVEL=INFO
