# CountVision settings for Docker. Copy to ".env" and edit. The .env file is never committed.

# --- 1) First test: the two test cameras (docker compose --profile test up -d --build) ---
# Uses test-camera/config.yaml (lines that match the test videos). Remove this line for real cameras.
CV_CONFIG=/test/config.yaml
CAM1_URL=rtsp://test-camera:8554/cam1
CAM2_URL=rtsp://test-camera:8554/cam2

# --- 2) Real cameras: delete the 3 lines above and fill in your camera addresses -----------
# The password stays in this file on the PC. It is never written to the log or status file.
# CAM1_URL=rtsp://user:password@192.168.1.20:554/stream2
# CAM2_URL=rtsp://user:password@192.168.1.21:554/stream2

# Time zone for "today" in reports
TZ=Europe/Berlin
