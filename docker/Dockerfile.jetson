# CountVision edge agent - NVIDIA Jetson (Orin Nano / NX / AGX with JetPack 6).
#
#   docker build -f docker/Dockerfile.jetson -t countvision-edge:jetson ..    (ON the Jetson)
#   docker run --runtime nvidia ... (or use compose with "runtime: nvidia")
#
# STATUS: NOT tested (no Jetson available). The ONNX Runtime GPU wheel for Jetson is not on
# PyPI; it comes from NVIDIA's Jetson AI Lab index (ARG ORT_INDEX). Check the index for your
# JetPack and CUDA version before building. TensorRT (faster) is a later step.
ARG BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    CV_DATA_DIR=/data \
    CV_MODELS=/opt/models \
    CV_CONFIG=/config/config.yaml \
    TZ=Europe/Berlin

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-pip ca-certificates tzdata libgl1 libglib2.0-0 \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv

WORKDIR /app
COPY edge/pyproject.toml edge/README.md /app/edge/
COPY edge/countvision_edge /app/edge/countvision_edge
ARG ORT_INDEX=https://pypi.jetson-ai-lab.io/jp6/cu126
RUN pip install /app/edge \
 && pip install --extra-index-url "${ORT_INDEX}" onnxruntime-gpu \
 && countvision-edge models download yolox_tiny --dir /opt/models

COPY edge/configs /app/configs
COPY docker/entrypoint.sh /usr/local/bin/countvision-entrypoint
RUN chmod 755 /usr/local/bin/countvision-entrypoint \
 && useradd --system --uid 10001 --gid 0 --groups video --create-home --home-dir /home/countvision countvision \
 && mkdir -p /data /config \
 && chown 10001:0 /data /config \
 && chmod 775 /data /config

USER 10001
VOLUME ["/data", "/config"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=15s --start-period=180s --retries=3 \
  CMD ["countvision-entrypoint", "health"]
ENTRYPOINT ["countvision-entrypoint"]
CMD ["run"]
